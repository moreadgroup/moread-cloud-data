{"seq": "7801", "word": "鲪", "pinyin": "jūn", "definition": "鱼类的一属，体长形，口大而斜，生活在海中，卵胎生。", "words":[ ], "sentences":[ ] }
{"seq": "7802", "word": "鲬", "pinyin": "yǒng", "definition": "鱼的一类，身体长形，无鳔，肉可食。", "words":[ ], "sentences":[ ] }
