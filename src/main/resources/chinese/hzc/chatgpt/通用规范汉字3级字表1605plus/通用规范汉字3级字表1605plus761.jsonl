{"seq": "7273", "word": "𬘬", "pinyin": "yǎn", "definition": "眼睛；眼光；姓氏", "words": ["𬘬睛[yǎnjīng]", "𬘬光[yǎnguāng]", "𬘬姓[yǎnxìng]"], "sentences": ["他的𬘬睛很大很亮。[yǎnjīng]", "他的𬘬光里透出一丝疑惑。[yǎnguāng]", "𬘬姓是一个不常见的姓氏。[yǎnxìng]"]}
{"seq": "7274", "word": "𬘭", "pinyin": "yǐn", "definition": "引；引导；引起；姓氏", "words": ["𬘭导[yǐndǎo]", "𬘭起[yǐnqǐ]", "𬘭姓[yǐnxìng]"], "sentences": ["他是我们的老师，也是我们的𬘭导者。[yǐndǎo]", "这件事𬘭起了很大的反响。[yǐnqǐ]", "𬘭姓是一个罕见的姓氏。[yǐnxìng]"] }
{"seq": "7275", "word": "𬴂", "pinyin": "shēn", "definition": "身；身体；身份；姓氏", "words": ["𬴂体[shēntǐ]", "𬴂份[shēnfèn]", "𬴂姓[shēnxìng]"], "sentences": ["他的𬴂体很健康，从不生病。[shēntǐ]", "他的𬴂份是一名医生。[shēnfèn]", "𬴂姓是一个普遍的姓氏。[shēnxìng]"] }
{"seq": "7276", "word": "𫘦", "pinyin": "chái", "definition": "柴；柴火；柴草；姓氏", "words": ["𫘦火[cháihuǒ]", "𫘦草[cháicǎo]", "𫘦姓[cháixìng]"], "sentences": ["他去山上砍了一些𫘦火回来。[cháihuǒ]", "他用一捆捆的𫘦草搭了一个小屋。[cháicǎo]", "柴姓是一个常见的姓氏。[cháixìng]"] }
