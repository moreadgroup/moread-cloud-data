{"seq": "5273", "word": "焜", "pinyin": "kūn", "definition": "形容太阳、火光等耀眼明亮", "words":[ "耀眼", "灿烂"], "sentences":[ "太阳升起时，整个天空都被焜烧得通红。", "烈日当空，晶莹的沙粒反射出夺目的焜光。" ] }
{"seq": "5278", "word": "渫", "pinyin": "xiè", "definition": "过滤", "words":[ "过滤", "澄清"], "sentences":[ "把污水通过多层滤网渫净后，才能用于灌溉。", "他用细布渫去饮料中的杂质，使它变得清澈透明。" ] }
{"seq": "5281", "word": "湜", "pinyin": "shì", "definition": "形容水清澈透明", "words":[ "清澈", "透明"], "sentences":[ "在这片河水里，小鱼游来游去，清澈透明的湜湜水波荡漾。", "夏日清晨，山间的小溪湜湜流淌，给人带来清凉舒爽的感觉。" ] }
{"seq": "5284", "word": "湫", "pinyin": "qiū", "definition": "形容小溪、细流等慢慢流动", "words":[ "慢流", "细流"], "sentences":[ "小溪在岩石间蜿蜒流动，湫湫之声清晰可闻。", "细流在沟壑间蜿蜒曲折，形成一道美丽的景观。" ] }
{"seq": "5288", "word": "湲", "pinyin": "yuán", "definition": "形容水波荡漾", "words":[ "水波", "荡漾"], "sentences":[ "湖水微风拂面，泛起了一层层湲湲的涟漪。", "月光下，湾中的小船随着水波荡漾，看上去格外安静美丽。" ] }
{"seq": "5289", "word": "湔", "pinyin": "jiān", "definition": "清洗", "words":[ "洗涤", "清洗"], "sentences":[ "宝石饰品需要定期湔洗，才能保持光彩照人。", "衣服被弄脏了，得赶快湔洗一下，否则就洗不掉了。" ] }
{"seq": "5290", "word": "湉", "pinyin": "tián", "definition": "水泡沫", "words":[ "湉湉水泡"], "sentences":[ "那个小女孩的脸上布满了湉湉的水泡。" ] }
{"seq": "5296", "word": "愦", "pinyin": "kuì", "definition": "心中懊悔", "words":[ "愦悔", "无愦"], "sentences":[ "他心中很愦悔没能好好利用自己的机会。", "我现在做事一定会非常努力，不给自己留下无愦的机会。" ] }
{"seq": "5300", "word": "愔", "pinyin": "yīn", "definition": "不吉利的样子", "words":[ "愔愔不祥"], "sentences":[ "那天晚上的月亮看起来愔愔不祥的，像是预示着什么不好的事情即将发生。" ] }
{"seq": "5301", "word": "喾", "pinyin": "kù", "definition": "盛大", "words":[ "喾盛"], "sentences":[ "他的喜宴非常喾盛，各种名流都来了。" ] }
{"seq": "5306", "word": "裎", "pinyin": "chéng", "definition": "裸体", "words":[ "裎裎"], "sentences":[ "他赤裸裎裎地站在那里，让人感到非常尴尬。" ] }
{"seq": "5307", "word": "裥", "pinyin": "jiǎn", "definition": "裤腿", "words":[ "裥子"], "sentences":[ "他的裤裥子太长了，拖在地上很不方便。" ] }
{"seq": "5308", "word": "祾", "pinyin": "líng", "definition": "指神明的恩典或保佑", "words":[ "祾赐"], "sentences":[ "我们应该珍惜祾赐，努力奋斗，才能获得更多的成功。" ] }
{"seq": "5310", "word": "谠", "pinyin": "dǎng", "definition": "尊崇、推崇", "words":[ "推谠"], "sentences":[ "他的人品和能力都很出色，值得我们大家一起推谠。" ] }
{"seq": "5319", "word": "骘", "pinyin": "zhì", "definition": "记录", "words":[ "骘文"], "sentences":[ "这些古老的骘文记录了很多关于我们祖先的历史和传说。" ] }
{"seq": "5323", "word": "巯", "pinyin": "qiú", "definition": "一种有机化合物名，指的是2,5-环己二烯酮", "words":[ "巯基"], "sentences":[ "巯基是一种含硫基团的官能团。"] }
{"seq": "5324", "word": "翚", "pinyin": "huī", "definition": "翱翔的样子", "words":[ "翚翔", "翚风"], "sentences":[ "鸟儿展翅高飞，翚翔于蓝天之上。", "翚风满面，驱走了炎热的夏日。"] }
{"seq": "5329", "word": "缃", "pinyin": "xiāng", "definition": "颜色像鹅黄色的样子", "words":[ "缃色", "缃草"], "sentences":[ "她穿了一袭缃色的旗袍，显得格外娇艳。", "春天里，路边的缃草和野花一起绽放，色彩斑斓。"] }
{"seq": "5332", "word": "缇", "pinyin": "tí", "definition": "浅红色的颜色，同’绨‘", "words":[ "缇色", "缇绫"], "sentences":[ "她穿着一条缇色的长裙，显得温婉可人。", "这件衣服是用缇绫织成的，手感柔软舒适。"] }
{"seq": "5334", "word": "缌", "pinyin": "sī", "definition": "一种绸缎的名称，也称’丝缌‘", "words":[ "缌麻", "缌丝"], "sentences":[ "缌麻是一种纺织品，透气性好，非常适合夏天穿着。", "缌丝是指用丝绸做成的缎子。"] }